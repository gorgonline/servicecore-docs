{
  "name": "servicecore-docs",
  "version": "0.1.2",
  "private": true,
  "scripts": {
    "build": "fumadocs-mdx && next build",
    "dev": "next dev",
    "start": "next start",
    "types:check": "next typegen && fumadocs-mdx && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "check:mdx": "node scripts/check-mdx.mjs",
    "check": "npm run check:mdx && npm run build && npm run types:check"
  },
  "dependencies": {
    "cnfast": "^0.0.8",
    "fumadocs-core": "16.12.0",
    "fumadocs-mdx": "15.2.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.12.0",
    "lucide-react": "^1.25.0",
    "next": "16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.21",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "zod": "4.4.3"
  }
}
